{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ornith-round.schema.json",
  "type": "object",
  "required": [
    "phase",
    "case_id",
    "round_index",
    "started_at_utc",
    "request_start_ns",
    "request_sent_ns",
    "first_sse_event_ns",
    "first_output_ns",
    "response_end_ns",
    "cache_n",
    "prompt_n",
    "prompt_ms",
    "prefill_tok_s",
    "predicted_n",
    "predicted_ms",
    "decode_tok_s",
    "ttft_ms",
    "post_upload_ttft_ms",
    "total_wall_ms",
    "reasoning_tokens",
    "answer_tokens",
    "tool_calls",
    "tool_latency_ms_sum",
    "tool_round_wall_ms",
    "normal_speed_sample",
    "outcome",
    "abort_reason",
    "context_budget"
  ],
  "properties": {
    "phase": {"enum": ["cold", "warm", "sustained"]},
    "case_id": {"type": "string", "pattern": "^[A-Z]-[0-9]{2}$"},
    "round_index": {"type": "integer", "minimum": 0},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "request_start_ns": {"type": ["integer", "null"]},
    "request_sent_ns": {"type": ["integer", "null"]},
    "first_sse_event_ns": {"type": ["integer", "null"]},
    "first_output_ns": {"type": ["integer", "null"]},
    "response_end_ns": {"type": ["integer", "null"]},
    "cache_n": {"type": ["integer", "null"]},
    "prompt_n": {"type": ["integer", "null"]},
    "prompt_ms": {"type": ["number", "null"]},
    "prefill_tok_s": {"type": ["number", "null"]},
    "predicted_n": {"type": ["integer", "null"]},
    "predicted_ms": {"type": ["number", "null"]},
    "decode_tok_s": {"type": ["number", "null"]},
    "ttft_ms": {"type": ["number", "null"]},
    "post_upload_ttft_ms": {"type": ["number", "null"]},
    "total_wall_ms": {"type": ["number", "null"]},
    "reasoning_tokens": {"type": ["integer", "null"]},
    "answer_tokens": {"type": ["integer", "null"]},
    "tool_calls": {"type": "array"},
    "tool_latency_ms_sum": {"type": ["number", "null"]},
    "tool_round_wall_ms": {"type": ["number", "null"]},
    "normal_speed_sample": {"type": "boolean"},
    "outcome": {"enum": ["pass", "fail", "abort"]},
    "abort_reason": {"type": ["string", "null"]},
    "context_budget": {
      "type": ["object", "null"],
      "required": [
        "fits",
        "prompt_tokens",
        "reserved_tokens",
        "context_size",
        "headroom_tokens",
        "provenance",
        "rendered_prompt_sha256",
        "template_provenance"
      ],
      "properties": {
        "fits": {"const": true},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "reserved_tokens": {"type": "integer", "minimum": 1},
        "context_size": {"type": "integer", "minimum": 1},
        "headroom_tokens": {"type": "integer", "minimum": 0},
        "provenance": {"type": "string", "minLength": 1},
        "rendered_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template_provenance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
