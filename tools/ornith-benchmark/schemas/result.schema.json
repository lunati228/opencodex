{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ornith-result.schema.json",
  "$defs": {
    "benchWorkload": {
      "type": "object",
      "required": [
        "samples_ts",
        "samples_ns",
        "repetitions",
        "median_ts",
        "minimum_ts",
        "maximum_ts",
        "median_absolute_deviation_ts",
        "arithmetic_mean_ts"
      ],
      "properties": {
        "samples_ts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "samples_ns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "minimum": 0}
        },
        "repetitions": {"type": "integer", "minimum": 1},
        "median_ts": {"type": "number", "exclusiveMinimum": 0},
        "minimum_ts": {"type": "number", "exclusiveMinimum": 0},
        "maximum_ts": {"type": "number", "exclusiveMinimum": 0},
        "median_absolute_deviation_ts": {"type": "number", "minimum": 0},
        "arithmetic_mean_ts": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "tokenField": {
      "type": "object",
      "required": ["count", "provenance", "sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "provenance": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "tokenCounts": {
      "type": "object",
      "required": ["reasoning", "answer", "tool_calls", "provenance"],
      "properties": {
        "reasoning": {"$ref": "#/$defs/tokenField"},
        "answer": {"$ref": "#/$defs/tokenField"},
        "tool_calls": {"$ref": "#/$defs/tokenField"},
        "provenance": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "serverCase": {
      "type": "object",
      "required": ["case_id", "run"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Z]-[0-9]{2}$"},
        "category": {"type": "string"},
        "score": {"type": "object"},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "run": {
          "type": "object",
          "required": ["rounds", "tool_round_count", "token_counts"],
          "properties": {
            "rounds": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "ornith-round.schema.json"}
            },
            "tool_round_count": {"type": "integer", "minimum": 0},
            "token_counts": {"$ref": "#/$defs/tokenCounts"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "coldCase": {
      "type": "object",
      "required": ["case_id", "load_duration_ms", "round"],
      "properties": {
        "case_id": {"const": "C-01"},
        "load_duration_ms": {"type": "number", "minimum": 0},
        "round": {
          "type": "object",
          "required": [
            "request_start_ns",
            "request_sent_ns",
            "first_sse_event_ns",
            "first_output_ns",
            "response_end_ns",
            "ttft_ms",
            "post_upload_ttft_ms",
            "total_wall_ms",
            "timings",
            "usage"
          ],
          "properties": {
            "request_start_ns": {"type": "integer", "minimum": 0},
            "request_sent_ns": {"type": "integer", "minimum": 0},
            "first_sse_event_ns": {"type": "integer", "minimum": 0},
            "first_output_ns": {"type": "integer", "minimum": 0},
            "response_end_ns": {"type": "integer", "minimum": 0},
            "ttft_ms": {"type": "number", "minimum": 0},
            "post_upload_ttft_ms": {"type": "number", "minimum": 0},
            "total_wall_ms": {"type": "number", "minimum": 0},
            "timings": {
              "type": "object",
              "required": ["predicted_n", "predicted_ms"],
              "properties": {
                "predicted_n": {"type": "integer", "minimum": 1},
                "predicted_ms": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": true
            },
            "usage": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sustainedSample": {
      "type": "object",
      "required": [
        "sample_id",
        "case_index",
        "case_id",
        "round_index",
        "predicted_n",
        "predicted_ms",
        "decode_tok_s"
      ],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "case_index": {"type": "integer", "minimum": 0},
        "case_id": {"type": "string", "pattern": "^[A-Z]-[0-9]{2}$"},
        "round_index": {"type": "integer", "minimum": 0},
        "predicted_n": {"type": "integer", "minimum": 64},
        "predicted_ms": {"type": "number", "exclusiveMinimum": 0},
        "decode_tok_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "campaign_id", "candidate_id", "status", "identity", "config", "llama_bench", "server", "quality", "telemetry_summary", "gate", "raw_sha256"],
  "properties": {
    "schema_version": {"const": "ornith-bench-1"},
    "campaign_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "status": {"enum": ["complete", "invalid", "aborted"]},
    "identity": {
      "type": "object",
      "required": [
        "llama_tag",
        "llama_commit",
        "build_number",
        "bench_sha256",
        "server_sha256",
        "model_sha256",
        "suite_sha256",
        "host_id"
      ],
      "properties": {
        "llama_tag": {"type": "string"},
        "llama_commit": {"type": "string"},
        "build_number": {"type": "integer", "minimum": 1},
        "bench_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "server_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "suite_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "host_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "required": ["load_mode", "use_mmap", "use_direct_io", "n_cpu_moe", "fit", "spec_type", "ctx_size", "generation_cap", "reasoning_budget"],
      "properties": {
        "load_mode": {"enum": ["mmap", "dio", "none"]},
        "use_mmap": {"type": "boolean"},
        "use_direct_io": {"type": "boolean"},
        "n_cpu_moe": {"type": "integer", "minimum": 0},
        "fit": {"const": "off"},
        "spec_type": {"const": "none"},
        "ctx_size": {"const": 8192},
        "generation_cap": {"const": 1024},
        "reasoning_budget": {"const": 1024}
      },
      "additionalProperties": true
    },
    "llama_bench": {
      "type": "object",
      "required": ["final"],
      "properties": {
        "final": {
          "type": "object",
          "required": ["pp8k", "tg1024-d8k", "pp16k", "tg1024-d16k"],
          "properties": {
            "pp8k": {"$ref": "#/$defs/benchWorkload"},
            "tg1024-d8k": {"$ref": "#/$defs/benchWorkload"},
            "pp16k": {"$ref": "#/$defs/benchWorkload"},
            "tg1024-d16k": {"$ref": "#/$defs/benchWorkload"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "server": {
      "type": "object",
      "required": [
        "cold",
        "warm",
        "sustained",
        "sustained_scoring_samples"
      ],
      "properties": {
        "cold": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/coldCase"}
        },
        "warm": {
          "type": "object",
          "required": ["cases"],
          "properties": {
            "cases": {
              "type": "array",
              "minItems": 17,
              "maxItems": 17,
              "items": {"$ref": "#/$defs/serverCase"}
            }
          },
          "additionalProperties": true
        },
        "sustained": {
          "type": "object",
          "required": ["cases"],
          "properties": {
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/serverCase"}
            }
          },
          "additionalProperties": true
        },
        "sustained_scoring_samples": {
          "type": "array",
          "minItems": 10,
          "items": {"$ref": "#/$defs/sustainedSample"}
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["passed", "total", "categories", "baseline_pass", "exceptional"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0, "maximum": 17},
        "total": {"const": 17},
        "categories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["passed", "total"],
            "properties": {
              "passed": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "baseline_pass": {"type": "boolean"},
        "exceptional": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "telemetry_summary": {
      "type": "object",
      "required": ["final", "cold", "warm", "sustained"],
      "properties": {
        "final": {"type": "object"},
        "cold": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "object"}
        },
        "warm": {"type": "object"},
        "sustained": {"type": "object"}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "decision",
        "speed_band",
        "minimum_median_decode_ts",
        "minimum_normal_sample_ts",
        "sustained_median_decode_ts",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "REMOVE",
            "FAIL",
            "CONDITIONAL_INTEGRATE",
            "INTEGRATE",
            "STRONG_INTEGRATE",
            "INVALID"
          ]
        },
        "speed_band": {
          "enum": [
            "lt_2_5",
            "gte_2_5_lt_3_0",
            "gte_3_0_lt_3_5",
            "gte_3_5_lte_4_0",
            "gt_4_0",
            null
          ]
        },
        "minimum_median_decode_ts": {"type": ["number", "null"]},
        "minimum_normal_sample_ts": {"type": ["number", "null"]},
        "sustained_median_decode_ts": {"type": ["number", "null"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {
            "properties": {"decision": {"const": "INVALID"}},
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "speed_band": {"type": "null"},
              "minimum_median_decode_ts": {"type": "null"},
              "minimum_normal_sample_ts": {"type": "null"},
              "sustained_median_decode_ts": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "speed_band": {
                "enum": [
                  "lt_2_5",
                  "gte_2_5_lt_3_0",
                  "gte_3_0_lt_3_5",
                  "gte_3_5_lte_4_0",
                  "gt_4_0"
                ]
              },
              "minimum_median_decode_ts": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minimum_normal_sample_ts": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sustained_median_decode_ts": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "raw_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  },
  "additionalProperties": true
}
