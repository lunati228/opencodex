{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ornith-telemetry.schema.json",
  "type": "object",
  "required": ["timestamp_utc", "monotonic_ns", "gpu_uuid", "pci_bus_id", "request_in_flight"],
  "properties": {
    "schema_version": {"const": "ornith-bench-1"},
    "campaign_id": {"type": "string"},
    "run_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "phase": {"enum": ["cold", "warm", "sustained"]},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "gpu_uuid": {"type": "string"},
    "pci_bus_id": {"type": "string"},
    "temperature_c": {"type": ["number", "null"]},
    "power_w": {"type": ["number", "null"]},
    "sm_clock_mhz": {"type": ["number", "null"]},
    "mem_clock_mhz": {"type": ["number", "null"]},
    "vram_used_mib": {"type": ["number", "null"]},
    "vram_total_mib": {"type": ["number", "null"]},
    "gpu_util_pct": {"type": ["number", "null"]},
    "mem_util_pct": {"type": ["number", "null"]},
    "pcie_gen_current": {"type": ["number", "null"]},
    "pcie_width_current": {"type": ["number", "null"]},
    "pcie_rx_mb_s": {"type": ["number", "null"]},
    "pcie_tx_mb_s": {"type": ["number", "null"]},
    "thermal_throttle": {"type": ["boolean", "null"]},
    "power_throttle": {"type": ["boolean", "null"]},
    "ecc_or_replay_error": {"type": ["boolean", "null"]},
    "request_in_flight": {"type": "boolean"}
  },
  "additionalProperties": false
}
