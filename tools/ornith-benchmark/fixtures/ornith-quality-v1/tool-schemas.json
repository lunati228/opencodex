[
  {
    "type": "function",
    "function": {
      "name": "apply_patch",
      "description": "Apply exact replacements to one allowlisted workspace file. The caller must supply the file's current SHA-256.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "expected_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 260},
          "expected_sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              {"type": "null"}
            ]
          },
          "create_content": {"type": "string", "maxLength": 1048576},
          "replacements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["old", "new"],
              "properties": {
                "old": {"type": "string", "minLength": 1},
                "new": {"type": "string"}
              }
            }
          }
        },
        "oneOf": [
          {"required": ["replacements"], "not": {"required": ["create_content"]}},
          {"required": ["create_content"], "not": {"required": ["replacements"]}}
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_diff",
      "description": "Return paths and hashes changed from the immutable starting tree.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_files",
      "description": "List visible fixture files. Hidden oracle, control, and Git metadata are excluded.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_file",
      "description": "Read one visible file inside the case workspace.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 260}
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "run_tests",
      "description": "Run one exact allowlisted test command without a shell and with the network guard preloaded.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id"],
        "properties": {
          "command_id": {"type": "string", "pattern": "^[a-z0-9-]{1,32}$"}
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_text",
      "description": "Perform a literal text search in visible fixture files.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
]
